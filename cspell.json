{
    "version": "0.2",
    "language": "en",
    "checkComments": true,
    "ignorePaths": [
        ".node_env/**/*",
        "node_modules/**/*",
        "**/Externals/**/*",
        "**/x64/**/*",
        "**/*.vcxproj*",
        "**/Dumps/**/*",
        ".cspell/**/*"
    ],
    "files": [
        "**/*.{cpp,h,hlsl,hlsli,txt,md}"
    ],
    "dictionaries": [
        "myDictionary"
    ],
    "dictionaryDefinitions": [
        {
            "name": "myDictionary",
            "path": "./exclusion.dic"
        }
    ]
}