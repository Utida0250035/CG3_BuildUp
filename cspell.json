{
    "version": "0.2",
    "language": "en-us",
    "checkComments": true,
    "ignorePaths": [
        ".node_env/**/*",
        "node_modules/**/*",
        "**/Externals/**/*",
        "**/x64/**/*",
        "**/*.vcxproj*",
        "**/Dumps/**/*",
        ".cspell/**/*",
        "**/*.cmd",
        "**/*/nul"
    ],
    "files": [
        "**/*.{cpp,h,hlsl,hlsli,txt,md}"
    ],
    "dictionaries": [
        "myDictionary"
    ],
    "dictionaryDefinitions": [
        {
            "name": "myDictionary",
            "path": "./exclusion.dic"
        }
    ],
    "patterns": [
        {
            "name": "full-width-alphanumeric",
            "regexp": "[Ａ-Ｚａ-ｚ０-９]"
        }
    ],
    "rejectRegExpList": [
        "full-width-alphanumeric"
    ]
}